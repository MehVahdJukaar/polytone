{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_github}"
  },
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.mehvahdjukaar.polytone.platform.PolytoneFabric"
    ],
    "modmenu": [
      "net.mehvahdjukaar.polytone.integration.fabric.ModMenuCompat"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}-common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18",
    "fabric": ">=0.140.0+1.21.11",
    "minecraft": "=${minecraft_version}"
  }
}