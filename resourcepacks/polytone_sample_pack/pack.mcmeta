{
  "pack": {
    "pack_format": 75,
    "supported_formats": [69, 90],
    "min_format": 69,
    "max_format": 90,
    "description": [
      "§bPolytone §rSample Pack §8v1.1",
      " §7by MehVahdJukaar"
    ]
  },
  "polytone": {
    "title": {
      "text": "",
      "extra": [
        { "text": "Polytone Sample Pack", "color": "aqua", "bold": true },
        { "text": "\nby MehVahdJukaar", "color": "gray" }
      ]
    },
    "content": {
      "text": "",
      "extra": [
        { "text": "One small file per feature, so you can copy what you need into your own pack.\n", "color": "white" },
        { "text": "Turn on 'Advanced Examples' from the config button on this screen to load the expression, particle and shader examples too.\n\n" },
        {
          "text": "Wiki",
          "color": "#7FE3A0",
          "underlined": true,
          "click_event": { "action": "open_url", "url": "https://github.com/MehVahdJukaar/polytone/wiki" },
          "hover_event": { "action": "show_text", "value": "Every field in this pack is documented there" }
        },
        { "text": "   " },
        {
          "text": "Discord",
          "color": "#5865F2",
          "underlined": true,
          "click_event": { "action": "open_url", "url": "https://discord.com/invite/qdKRTDf8Cv" },
          "hover_event": { "action": "show_text", "value": "Get help and show off your pack" }
        }
      ]
    }
  },
  "overlays": {
    "entries": [
      {
        "directory": "advanced",
        "formats": [69, 90],
        "min_format": 69,
        "max_format": 90,
        "polytone_condition": {
          "require_config": "polytone_sample:advanced"
        }
      }
    ]
  }
}
