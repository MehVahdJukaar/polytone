<?xml version="1.0" encoding="UTF-8"?>
<profiles version="12">
    <profile kind="CodeFormatterProfile" name="minimal-wrap" version="12">

        <!-- Use spaces instead of tabs -->
        <setting id="org.eclipse.jdt.core.formatter.tabulation.char" value="space"/>
        <setting id="org.eclipse.jdt.core.formatter.tabulation.size" value="4"/>
        <setting id="org.eclipse.jdt.core.formatter.indentation.size" value="4"/>

        <!-- Practically disable line wrapping -->
        <setting id="org.eclipse.jdt.core.formatter.lineSplit" value="999"/>
        <setting id="org.eclipse.jdt.core.formatter.join_wrapped_lines" value="false"/>
        <setting id="org.eclipse.jdt.core.formatter.alignment_for_arguments_in_method_invocation" value="0"/>
        <setting id="org.eclipse.jdt.core.formatter.alignment_for_selector_in_method_invocation" value="0"/>
        <setting id="org.eclipse.jdt.core.formatter.alignment_for_chained_method_calls" value="0"/>
        <setting id="org.eclipse.jdt.core.formatter.keep_simple_if_on_one_line" value="true"/>
        <setting id="org.eclipse.jdt.core.formatter.keep_else_statement_on_same_line" value="true"/>

    </profile>
</profiles>